# Local example. Start both services and install the actual models first.
# Alias workaround for the tested Cognee/LiteLLM versions; see diagnostic/COGNEE-NOTES.md.
# ollama cp gemma3:12b gpt-4o
TELEMETRY_DISABLED=true
CACHING=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
ACTUAL_MODEL=gemma3:12b
LLM_ENDPOINT=http://localhost:11434/v1
LLM_API_KEY=ollama
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_ENDPOINT=http://localhost:8080/v1
EMBEDDING_MODEL=unsloth/embeddinggemma-300m
EMBEDDING_DIMENSIONS=768
EMBEDDING_API_KEY=local
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_CONCURRENT_DATA_POINTS=16
LLM_MAX_COMPLETION_TOKENS=8192
COGNEE_SKIP_CONNECTION_TEST=true
